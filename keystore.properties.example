# Copy to keystore.properties (git-ignored) and fill in to sign release builds.
# On Windows escape the drive colon: C\:/Users/you/.justtrack/justtrack-release.jks
#
# CI alternative: environment variables JUSTTRACK_STORE_FILE, JUSTTRACK_STORE_PASSWORD,
# JUSTTRACK_KEY_ALIAS, JUSTTRACK_KEY_PASSWORD.
storeFile=/path/to/justtrack-release.jks
storePassword=
keyAlias=justtrack
keyPassword=
