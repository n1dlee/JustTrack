    <!-- Accessibility Service -->
    <string name="accessibility_service_description">JustTrack выполняет нажатия, свайпы и системные действия («Назад», «Домой», список приложений) по жестам руки перед фронтальной камерой и запоминает предыдущее открытое приложение для жеста 👎. Содержимое экрана не читается, данные не сохраняются и не передаются.</string>
