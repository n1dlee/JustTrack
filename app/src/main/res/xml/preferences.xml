<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/pref_category_gesture">

        <SeekBarPreference
            android:key="pref_pinch_sensitivity"
            android:title="@string/pref_pinch_sensitivity"
            android:summary="@string/pref_pinch_sensitivity_summary"
            android:defaultValue="5"
            android:max="10"
            app:min="1"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            android:key="pref_move_sensitivity"
            android:title="@string/pref_move_sensitivity"
            android:summary="@string/pref_move_sensitivity_summary"
            android:defaultValue="5"
            android:max="10"
            app:min="1"
            app:showSeekBarValue="true" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_category_hand">

        <ListPreference
            android:key="pref_main_hand"
            android:title="@string/pref_main_hand"
            android:summary="@string/pref_main_hand_summary"
            android:defaultValue="both"
            android:entries="@array/hand_entries"
            android:entryValues="@array/hand_values" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_category_feedback">

        <SwitchPreferenceCompat
            android:key="pref_haptic_feedback"
            android:title="@string/pref_haptic_feedback"
            android:summary="@string/pref_haptic_feedback_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_category_system">

        <SwitchPreferenceCompat
            android:key="pref_auto_start"
            android:title="@string/pref_auto_start"
            android:summary="@string/pref_auto_start_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

</PreferenceScreen>
